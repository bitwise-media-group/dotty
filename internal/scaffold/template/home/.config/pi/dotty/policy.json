{
  "bash": {
    "allow": [
      "pwd",
      "hostname",
      "whoami",
      "id",
      "id *",
      "uptime",
      "uname",
      "uname *",
      "date",
      "date *",
      "ls",
      "ls *",
      "stat *",
      "file *",
      "wc *",
      "tree",
      "tree *",
      "which *",
      "type *",
      "command -v *",
      "echo *",
      "printf *",
      "cat *",
      "head *",
      "tail *",
      "grep *",
      "rg *",
      "find *",
      "jq *",
      "yq *",
      "mise ls",
      "mise ls *",
      "mise registry",
      "mise registry *",
      "mise outdated",
      "mise outdated *",
      "mise config ls",
      "mise bootstrap packages status",
      "mise bootstrap packages status *",
      "git status",
      "git status *",
      "git diff",
      "git diff *",
      "git log",
      "git log *",
      "git show *",
      "git blame *",
      "git ls-files",
      "git ls-files *",
      "git rev-parse *",
      "git config --get *",
      "git branch",
      "git branch --list",
      "git branch --list *",
      "git stash list",
      "git worktree list",
      "git remote",
      "git remote -v",
      "git remote get-url *",
      "git add *",
      "git restore *",
      "git checkout *",
      "git switch *",
      "git commit *",
      "swift *",
      "swiftc *",
      "swift test*",
      "swift build*",
      "swift package *",
      "xcodebuild *",
      "xcrun *",
      "simctl *",
      "mise *",
      "mise exec *",
      "mise run *"
    ],
    "deny": [
      {
        "pattern": "(^|[^A-Za-z0-9_])\\.env|\\.ssh([/\\s]|$)|\\.aws([/\\s]|$)|\\.azure([/\\s]|$)|\\.config/gcloud|\\.gnupg([/\\s]|$)",
        "reason": "the command references a credential path (~/.ssh, ~/.aws, ~/.azure, ~/.config/gcloud, ~/.gnupg, .env)"
      },
      {
        "pattern": "(^|[;&|/\\s])security(\\s|$)",
        "reason": "the command runs the macOS keychain tool (security)"
      },
      {
        "pattern": "(^|[;&|/\\s])fnox(\\s|$)",
        "reason": "the command runs fnox, which brokers every secret"
      }
    ]
  },
  "readOnlyTools": ["read", "grep", "find", "ls", "tool_search"]
}
