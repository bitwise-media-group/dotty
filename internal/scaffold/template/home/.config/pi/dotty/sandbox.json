{
  "network": {
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "objects.githubusercontent.com",
      "raw.githubusercontent.com",
      "codeload.github.com",
      "ghcr.io",
      "codeberg.org",
      "code.forgejo.org",

      "pypi.org",
      "files.pythonhosted.org",

      "formulae.brew.sh",

      "nodejs.org",
      "registry.npmjs.org",

      "proxy.golang.org",
      "sum.golang.org",
      "index.golang.org",
      "vuln.go.dev",

      "mise.jdx.dev",
      "mise-versions.jdx.dev",

      "registry.terraform.io",

      "localhost",
      "127.0.0.1",
      "::1",

      "fonts.googleapis.com",
      "fonts.gstatic.com",

      "istio-release.storage.googleapis.com",
      "prometheus-community.github.io",
      "registry.istio.io",
      "registry.k8s.io",
      "grype.anchore.io",
      "toolbox-data.anchore.io",
      "*.sigstore.dev",

      "docker.io",
      "registry-1.docker.io",
      "auth.docker.io",
      "index.docker.io",
      "quay.io",
      "*.quay.io",
      "*.pkg.dev",
      "production.cloudflare.docker.com",
      "cgr.dev",

      "*.s3.dualstack.eu-west-1.amazonaws.com",
      "*.s3.dualstack.eu-west-2.amazonaws.com",
      "public.ecr.aws",
      "*.amazonaws.com"
    ],
    "deniedDomains": [],
    "allowUnixSockets": [
      "/tmp",
      "/private/tmp"
    ],
    "allowLocalBinding": true,
    "allowMachLookup": [
      "com.apple.trustd",
      "com.apple.trustd.agent",

      "com.apple.mDNSResponder",
      "com.apple.dnssd",
      "com.apple.system.opendirectoryd.api",
      "com.apple.system.DirectoryService.api"
    ]
  },
  "filesystem": {
    "allowWrite": [
      "~/Repos",
{{- if .WorktreesAbs }}
      "{{.WorktreesAbs}}",
{{- end }}
      "~/.cache",
      "~/.local/bin",
      "~/.local/share/go",
      "~/.local/share/mise",
      "~/.local/state",
      "/tmp",
      "~/.npm",
      "~/.config/helm",
      "~/.kubescape",
      "~/.sigstore",
      "~/Library/Caches",
      "~/Library/org.swift.swiftpm"
    ],
    "denyRead": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.ssh",
      "~/.gnupg",
      "**/.env*"
    ],
    "denyWrite": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.ssh",
      "~/.gnupg",
      "**/.env*",

      "~/.config/pi",
      "{{.DotfilesDir}}"
    ],
    "allowRead": [
      "~/Repos",
      "~/.config",
      "~/.cache",
      "~/.local/bin",
      "~/.local/runtime",
      "~/.local/share",
      "~/.local/state",
      "~/.npm",
      "/opt/homebrew",
      "/tmp",
      "~/Library/Caches",
      "~/Library/org.swift.swiftpm"
    ]
  },
  "enableWeakerNestedSandbox": false,
  "enableWeakerNetworkIsolation": false
}
