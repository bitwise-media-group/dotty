# Private per-profile drop-ins (host blocks, internal names) load first:
# ssh takes the first obtained value, so anything here beats the defaults
# below. The directory is optional — dotty private link populates it.
Include ~/.ssh/config.d/*.conf

Match host * exec "dotty signing-key link >/dev/null"
	IdentityFile ~/.ssh/id_sk_current
	IdentitiesOnly yes
	IdentityAgent none
  Compression yes
