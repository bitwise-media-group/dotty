.TH "DOTTY" "1" "Jun 2026" "Auto generated by spf13/cobra" ""

.SH NAME
dotty-brewfile-remove - Remove entries from the Brewfile.


.SH SYNOPSIS
\fBdotty brewfile remove [--tap | --cask | --formula | ...] [ ...] [flags]\fP


.SH DESCRIPTION
Remove one or more entries from the Brewfile, or pick several interactively
(a filterable checklist) when no name is given. Entries default to formulae;
pass a type flag for anything else. Trust grants recorded for removed
tap-qualified names (and taps) are revoked best-effort. Nothing is
uninstalled: removed entries stay on the machine until
\fBdotty brewfile sync\fR removes what the Brewfile no longer lists —
pass --sync to run it immediately.


.SH OPTIONS
\fB--cargo\fP[=false]
	remove Cargo packages

.PP
\fB--cask\fP[=false]
	remove casks

.PP
\fB--flatpak\fP[=false]
	remove Flatpak packages

.PP
\fB--formula\fP[=false]
	remove formulae (the default)

.PP
\fB--go\fP[=false]
	remove Go packages

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for remove

.PP
\fB--krew\fP[=false]
	remove Krew plugins

.PP
\fB--mas\fP[=false]
	remove Mac App Store entries

.PP
\fB--npm\fP[=false]
	remove npm packages

.PP
\fB--sync\fP[=false]
	run \fBdotty brewfile sync\fR after removing

.PP
\fB--tap\fP[=false]
	remove taps

.PP
\fB--uv\fP[=false]
	remove uv tools

.PP
\fB--vscode\fP[=false]
	remove VSCode extensions


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--profile\fP=""
	profile to operate on (defaults to the active profile)


.SH EXAMPLE
.EX
  dotty brewfile remove ripgrep jq
  dotty brewfile remove --cask ghostty
  dotty brewfile rm --tap
  dotty brewfile remove --sync acme/tap/widget
.EE


.SH SEE ALSO
\fBdotty-brewfile(1)\fP
